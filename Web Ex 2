
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Health & Wellness Blog</title>

    <style>
        body {
            background-color: #eeeeee;
            font-family: Arial;
            margin: 0;
            color: #222;
        }

        .header {
            background-color: white;
            padding: 25px;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            color: #176b55;
        }

        .header p {
            margin-bottom: 0;
            color: gray;
        }

        .nav {
            background-color: #176b55;
            text-align: center;
            padding: 15px;
        }

        .nav a {
            color: white;
            text-decoration: none;
            margin: 25px;
            font-weight: bold;
        }

        .container {
            width: 86%;
            margin: auto;
        }

        .section {
            background-color: white;
            margin-top: 20px;
            padding: 25px;
        }

        h2 {
            color: #176b55;
        }

        .hero {
            background-color: #164b3e;
            color: white;
            margin-top: 20px;
            padding: 25px;
        }

        .hero h2 {
            color: white;
            font-size: 30px;
        }

        .hero p {
            color: lightgray;
        }

        .health-image {
            width: 100%;
            height: auto;
            margin-top: 15px;
        }

        .row {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 20px;
        }

        .half {
            width: 47%;
            background-color: white;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table, th, td {
            border: 1px solid lightgray;
        }

        th {
            background-color: #176b55;
            color: white;
        }

        th, td {
            padding: 12px;
            text-align: center;
        }

        fieldset {
            margin-bottom: 20px;
            padding: 20px;
            border: 1px solid lightgray;
        }

        legend {
            font-weight: bold;
            color: #176b55;
        }

        label {
            font-weight: bold;
        }

        input, select, textarea {
            padding: 9px;
            margin-top: 6px;
            margin-bottom: 15px;
        }

        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="number"],
        select,
        textarea {
            width: 95%;
        }

        .button {
            background-color: #176b55;
            color: white;
            border: none;
            padding: 12px 25px;
            margin: 5px;
        }

        progress {
            width: 100%;
            height: 25px;
        }

        video {
            width: 100%;
        }

        audio {
            width: 100%;
        }

        embed {
            width: 100%;
            height: 500px;
        }

        iframe {
            width: 100%;
            height: 350px;
        }

        .footer {
            background-color: #164b3e;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <!-- Header Section -->

    <div class="header">

        <h1>HealthyLife</h1>

        <p>Your Guide to Health, Fitness and Wellness</p>

    </div>


    <!-- Navigation Section -->

    <div class="nav">

        <a href="#home">Home</a>
        <a href="#tips">Health Tips</a>
        <a href="#feedback">Feedback</a>
        <a href="#media">Media</a>
        <a href="#contact">Contact</a>

    </div>


    <div class="container">


        <!-- Home Section -->

        <div class="hero" id="home">

            <h2>Live Healthy, Stay Happy!</h2>

            <p>
                Discover simple ways to improve your health
                through fitness, balanced nutrition and
                mental wellness.
            </p>

            <img src="health.jpg"
                 alt="Healthy lifestyle"
                 class="health-image">

        </div>


        <!-- Health Tips Section -->

        <div class="section" id="tips">

            <h2>Our Health & Wellness Tips</h2>

            <p>
                Follow these simple habits to maintain a
                healthy lifestyle and improve your daily routine.
            </p>

            <table>

                <tr>
                    <th>Activity</th>
                    <th>Benefits</th>
                    <th>Recommended Time</th>
                </tr>

                <tr>
                    <td>Walking</td>
                    <td>Improves heart health</td>
                    <td>30 Minutes</td>
                </tr>

                <tr>
                    <td>Yoga</td>
                    <td>Reduces stress</td>
                    <td>20 Minutes</td>
                </tr>

                <tr>
                    <td>Meditation</td>
                    <td>Improves mental wellness</td>
                    <td>15 Minutes</td>
                </tr>

                <tr>
                    <td>Drinking Water</td>
                    <td>Maintains hydration</td>
                    <td>Throughout the day</td>
                </tr>

            </table>

        </div>


        <!-- Feedback Form Section -->

        <div class="section" id="feedback">

            <h2>Health & Wellness Feedback Form</h2>

            <p>
                Complete the form below to share your health
                interests and wellness goals.
            </p>

            <form>

                <fieldset>

                    <legend>Personal Information</legend>

                    <label>Full Name:</label>
                    <br>

                    <input type="text"
                           name="name"
                           placeholder="Enter your full name"
                           minlength="3"
                           maxlength="30"
                           pattern="[A-Za-z ]+"
                           required>

                    <br>

                    <label>Email:</label>
                    <br>

                    <input type="email"
                           name="email"
                           placeholder="Enter your email"
                           maxlength="50"
                           required>

                    <br>

                    <label>Phone Number:</label>
                    <br>

                    <input type="tel"
                           name="phone"
                           placeholder="Enter 10-digit mobile number"
                           pattern="[0-9]{10}"
                           maxlength="10"
                           required>

                    <br>

                    <label>Age:</label>
                    <br>

                    <input type="number"
                           name="age"
                           min="1"
                           max="100"
                           placeholder="Enter your age"
                           required>

                    <br>

                    <label>Address:</label>
                    <br>

                    <textarea rows="4"
                              cols="50"
                              placeholder="Enter your address"
                              minlength="5"
                              maxlength="150"
                              required></textarea>

                </fieldset>


                <fieldset>

                    <legend>Wellness Information</legend>

                    <label>Select Your Interest:</label>
                    <br>

                    <select name="interest" required>

                        <option value="">-- Select an Interest --</option>
                        <option>Fitness</option>
                        <option>Nutrition</option>
                        <option>Yoga</option>
                        <option>Meditation</option>
                        <option>Mental Wellness</option>

                    </select>

                    <br>

                    <label>Select Your Activity:</label>
                    <br><br>

                    <input type="radio"
                           name="activity"
                           value="walking"
                           required>
                    Walking

                    <input type="radio"
                           name="activity"
                           value="yoga">
                    Yoga

                    <input type="radio"
                           name="activity"
                           value="gym">
                    Gym

                    <br><br>

                    <label>Health Goals:</label>
                    <br><br>

                    <input type="checkbox"
                           name="goal"
                           value="fitness">
                    Improve Fitness

                    <br>

                    <input type="checkbox"
                           name="goal"
                           value="diet">
                    Healthy Diet

                    <br>

                    <input type="checkbox"
                           name="goal"
                           value="stress">
                    Reduce Stress

                    <br>

                    <input type="checkbox"
                           name="goal"
                           value="sleep">
                    Better Sleep

                </fieldset>


                <fieldset>

                    <legend>Wellness Goal Progress</legend>

                    <label>Daily Wellness Goal:</label>
                    <br><br>

                    <progress value="70" max="100"></progress>

                    <p>70% Complete</p>

                </fieldset>


                <input type="submit"
                       value="Submit Feedback"
                       class="button">

                <input type="reset"
                       value="Clear Form"
                       class="button">

            </form>

        </div>


        <!-- Media Section -->

        <div class="row" id="media">

            <div class="half">

                <h2>Fitness Videos</h2>

                <p>
                    Watch a short video about health
                    and fitness activities.
                </p>

                <video controls>

                    <source src="health-video.mp4"
                            type="video/mp4">

                    Your browser does not support the video tag.

                </video>

            </div>


            <div class="half">

                <h2>Meditation Audio</h2>

                <p>
                    Listen to relaxing audio for
                    mental wellness.
                </p>

                <audio controls>

                    <source src="health-audio.mp3"
                            type="audio/mpeg">

                    Your browser does not support the audio element.

                </audio>

            </div>

        </div>


        <!-- Health Information PDF and Location -->

        <div class="row">

            <div class="half">

                <h2>Health Information</h2>

                <p>
                    View our health and wellness
                    information document.
                </p>

                <embed src="health-info.pdf"
                       type="application/pdf">

            </div>


            <div class="half">

                <h2>Health Resources</h2>

                <p>
                    Explore health-related information
                    and resources.
                </p>

                <iframe src="https://www.who.int/health-topics">
                </iframe>

            </div>

        </div>


        <!-- Contact Section -->

        <div class="section" id="contact">

            <h2>Contact HealthyLife</h2>

            <p>
                <b>Email:</b> healthwellness@gmail.com
            </p>

            <p>
                <b>Phone:</b> +91 9876543210
            </p>

            <p>
                <b>Location:</b> Coimbatore, Tamil Nadu
            </p>

        </div>

    </div>


    <!-- Footer Section -->

    <div class="footer">

        <p>
            HealthyLife | Health & Wellness Blog |
            Web Technology Lab
        </p>

    </div>

</body>

</html>
